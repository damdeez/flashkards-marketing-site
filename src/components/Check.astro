---
interface Props {
  size?: number;
}

const { size = 22 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="var(--positive)"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  style="flex: none"
>
  <path d="M20 6 9 17l-5-5"></path>
</svg>
