---
import Brand from './Brand.astro';
import { site } from '../site';
---

<footer class="footer">
  <div class="inner">
    <div class="row">
      <div class="about">
        <Brand size={28} />
        <p class="callout muted">Flashcards for iPhone. Android coming soon.</p>
      </div>
      <ul class="links">
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/support">Support</a></li>
        <li><a class="email" href={`mailto:${site.email}`}>{site.email}</a></li>
      </ul>
    </div>
    <p class="copyright">
      © {new Date().getFullYear()} Flashkards · Made by <a class="credit" href={site.author.url}><span aria-hidden="true">👾 </span>{site.author.name}</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px var(--gutter);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .muted,
  .copyright {
    color: var(--muted);
  }

  .links {
    display: flex;
    gap: 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Matches the header links. */
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .links a:hover {
    color: var(--ink);
  }

  /* An address in caps is harder to read and copy, so it keeps its case. */
  .links .email {
    text-transform: none;
  }

  .copyright {
    font-size: 13px;
  }

  .credit {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition:
      color 120ms ease,
      text-decoration-color 120ms ease;
  }

  .credit:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  @media (max-width: 767px) {
    .inner {
      padding-block: 40px;
    }

    .row {
      flex-direction: column;
      align-items: flex-start;
    }

    .links {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
