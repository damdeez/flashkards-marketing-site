---
import Brand from './Brand.astro';
---

<header class="nav">
  <Brand />
  <nav aria-label="Main">
    <ul class="links">
      <li><a href="/#features">Features</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/support">Support</a></li>
    </ul>
    <a href="/#get-the-app" class="nav-cta">Get the app</a>
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1440px;
    margin: 0 auto;
    padding: 20px var(--gutter);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .links {
    display: flex;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .links a:hover {
    color: var(--ink);
  }

  .nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.16),
      0 4px 12px rgb(65 56 231 / 0.22);
    transition:
      transform 140ms ease,
      box-shadow 140ms ease,
      background-color 140ms ease;
  }

  .nav-cta:hover {
    background: var(--primary);
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.22),
      0 6px 14px rgb(65 56 231 / 0.2);
  }

  .nav-cta:active {
    transform: translateY(0);
  }

  @media (max-width: 767px) {
    .nav-cta {
      min-height: 44px;
    }

    .nav {
      padding-block: 14px;
    }

    .links {
      display: none;
    }
  }
</style>
