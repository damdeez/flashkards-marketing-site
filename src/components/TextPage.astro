---
// The shared layout for Privacy and Support: a header, an optional extra
// block (the slot), then the sections as a single card.
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  heading: string;
  intro: string;
  sections: { title: string; body: string }[];
}

const { title, description, eyebrow, heading, intro, sections } = Astro.props;
---

<Base title={title} description={description}>
  <article class="page">
    <header class="header">
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="h2">{heading}</h1>
      <p class="lead intro">{intro}</p>
    </header>
    <slot />
    <div class="sections">
      {
        sections.map((section) => (
          <section class="section">
            <h2 class="h3">{section.title}</h2>
            <p>{section.body}</p>
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 40px;
    max-width: calc(720px + 2 * var(--gutter));
    margin: 0 auto;
    padding: 72px var(--gutter) 120px;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .intro {
    color: var(--ink-soft);
  }

  .sections {
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 32px;
  }

  .section + .section {
    border-top: 1px solid var(--line);
  }

  .section p {
    color: var(--ink-soft);
  }

  @media (max-width: 767px) {
    .page {
      gap: 32px;
      padding-block: 40px 72px;
    }

    .section {
      padding: 24px 20px;
    }
  }
</style>
