---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Phone from '../components/Phone.astro';
import StoreBadges from '../components/StoreBadges.astro';
import Check from '../components/Check.astro';
import icon from '../assets/icon.png';
import library from '../assets/screens/library.png';
import deck from '../assets/screens/deck.png';
import deckImported from '../assets/screens/deck-imported.png';
import study from '../assets/screens/study.png';
import sessionComplete from '../assets/screens/session-complete.png';
import featureDecks from '../assets/features/decks.png';
import featureStudy from '../assets/features/study.png';
import featureImport from '../assets/features/import.png';

const features = [
  {
    image: featureDecks,
    alt: 'Two colour-coded decks: Spanish Verbs and Biology.',
    title: 'Decks you can find at a glance',
    body: 'Give each deck a name, a short description and a colour. Your library stays tidy however many subjects you add.',
  },
  {
    image: featureStudy,
    alt: 'A flashcard showing “hablar”, with its back “to speak” behind it.',
    title: 'Study with a swipe',
    body: 'Tap to flip. Swipe right when you know it, left when it needs review. Each session ends with a tally of how you did.',
  },
  {
    image: featureImport,
    alt: 'The import options: paste a link or choose a file.',
    title: 'Import from a sheet or CSV',
    body: 'Paste a Google Sheet link or pick a CSV or TSV file, choose the front and back columns, then check the cards before they’re added.',
  },
];

const steps = [
  {
    screen: deckImported,
    alt: 'A Spanish Verbs deck just after importing 212 cards.',
    title: 'Bring your cards in',
    body: 'Import a whole list at once, or add cards one at a time.',
  },
  {
    screen: study,
    alt: 'Studying a card, with Review and Know it buttons.',
    title: 'Swipe through the deck',
    body: 'Right for the ones you know, left for the ones to review.',
  },
  {
    screen: sessionComplete,
    alt: 'The session summary: 9 known, 3 to review.',
    title: 'See how you did',
    body: 'A quick tally at the end, then study again or head back to the deck.',
  },
];

const privacyPoints = [
  ['No account, no sign-in', 'Open the app and start a deck.'],
  ['No analytics or ads', 'Nothing in the app tracks what you study.'],
  ['Saved on your device', 'Decks and cards live in a small database on your phone.'],
  [
    'Works offline, anywhere',
    'Your cards are already on your phone, so you can study on a plane, on the subway, or anywhere without signal.',
  ],
  ['Imports read only what you pick', 'The sheet link or file you choose, and nothing else.'],
];
---

<Base>
  <section class="hero">
    <div class="hero-copy">
      <p class="pill">On iPhone · Android coming soon</p>
      <h1 class="display">Flashcards, minus the busywork.</h1>
      <p class="lead hero-lead">
        Make a deck in seconds, study with a swipe, and bring cards in from a Google Sheet or a CSV
        file.
      </p>
      <StoreBadges />
      <p class="note callout"><Check size={18} />No account needed, and it works offline.</p>
    </div>
    <div class="hero-art">
      <div class="glow" aria-hidden="true"></div>
      <Phone src={library} alt="The Flashkards library with five colour-coded decks." width={315} class="phone-a" priority />
      <Phone src={deck} alt="A Spanish Verbs deck with its cards." width={315} class="phone-b" loading="eager" />
    </div>
  </section>

  <section class="features" id="features">
    <header class="section-head">
      <p class="eyebrow">FEATURES</p>
      <h2 class="h2">Three things, done well.</h2>
      <p class="lead muted">Flashkards keeps it simple, so your time goes into learning instead of setting up.</p>
    </header>
    <div class="feature-grid">
      {
        features.map((feature) => (
          <article class="feature">
            <Image src={feature.image} alt={feature.alt} widths={[360, 720]} sizes="(max-width: 767px) 90vw, 360px" />
            <div class="feature-text">
              <h3 class="h3">{feature.title}</h3>
              <p>{feature.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="how">
    <header class="section-head">
      <h2 class="h2">From a spreadsheet to a study session in a minute.</h2>
      <p class="lead">Already keep your vocabulary in a sheet? Bring the whole list in at once.</p>
    </header>
    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step">
            <Phone src={step.screen} alt={step.alt} width={273} />
            <div class="step-text">
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              <h3 class="h3">{step.title}</h3>
              <p class="callout">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="privacy">
    <div class="privacy-head">
      <span class="lock" aria-hidden="true">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg
        >
      </span>
      <h2 class="h2">Your cards stay on your phone.</h2>
      <p class="lead muted">Private by default, and ready to study whenever you are, with or without a connection.</p>
      <a class="text-link" href="/privacy">Read the privacy policy →</a>
    </div>
    <ul class="points">
      {
        privacyPoints.map(([title, body]) => (
          <li class="point">
            <Check />
            <div>
              <p class="point-title">{title}</p>
              <p class="callout muted">{body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cta-wrap" id="get-the-app">
    <div class="cta">
      <Image src={icon} alt="" width={72} densities={[1, 2]} class="cta-logo" />
      <h2 class="h2">Start your first deck today.</h2>
      <p class="lead">Get it on the App Store today. Android is coming soon.</p>
      <StoreBadges align="center" stackOnMobile />
    </div>
  </section>
</Base>

<style>
  .muted {
    color: var(--muted);
  }

  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 580px) 620px;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    max-width: 1440px;
    margin: 0 auto;
    padding: 40px calc(var(--gutter) * 0.66) 96px var(--gutter);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  .pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--indigo-faint);
    color: var(--primary);
    font-size: 12px;
    font-weight: 600;
  }

  .hero-lead {
    color: var(--ink-soft);
  }

  .note {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
  }

  .hero-art {
    position: relative;
    height: 760px;
  }

  .glow {
    position: absolute;
    left: 10px;
    top: 80px;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    background: var(--indigo-light);
    opacity: 0.55;
  }

  .hero-art :global(.phone) {
    position: absolute;
  }

  .hero-art :global(.phone-a) {
    left: 30px;
    top: 20px;
  }

  .hero-art :global(.phone-b) {
    left: 305px;
    top: 92px;
  }

  @media (max-width: 1099px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
      padding: 24px var(--gutter) 64px;
    }

    .hero-copy {
      gap: 20px;
      max-width: 580px;
    }

    .hero-art {
      display: flex;
      justify-content: center;
      height: auto;
      padding-top: 10px;
    }

    .glow {
      left: 50%;
      top: 220px;
      width: 340px;
      height: 340px;
      transform: translateX(-50%);
    }

    .hero-art :global(.phone-a) {
      position: relative;
      left: auto;
      top: auto;
    }

    .hero-art :global(.phone-b) {
      display: none;
    }
  }

  /* Shared section heading */
  .section-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  /* Features */
  .features {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding: var(--section-y) var(--gutter);
    background: var(--surface);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
  }

  .feature {
    padding: 12px;
    border-radius: 28px;
    background: var(--bg);
  }

  .feature :global(img) {
    width: 100%;
    border-radius: 20px;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 16px;
  }

  .feature-text p {
    color: var(--ink-soft);
  }

  @media (max-width: 1023px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 480px;
      gap: 16px;
    }

    .features {
      gap: 40px;
    }
  }

  /* How it works */
  .how {
    display: flex;
    flex-direction: column;
    gap: 64px;
    padding: var(--section-y) var(--gutter);
    background: var(--banner);
    color: #fff;
  }

  .how .lead,
  .step .callout {
    color: rgb(255 255 255 / 0.7);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
  }

  .step-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    max-width: 300px;
    text-align: center;
  }

  .step-number {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    font-size: 12px;
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .how {
      gap: 48px;
    }

    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 56px;
    }
  }

  /* Privacy */
  .privacy {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 80px;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--section-y) var(--gutter);
  }

  .privacy-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .lock {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--indigo-faint);
    color: var(--primary);
  }

  .text-link {
    color: var(--primary);
    font-weight: 600;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .points {
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--surface);
  }

  .point {
    display: flex;
    gap: 16px;
    padding: 22px 28px;
  }

  .point + .point {
    border-top: 1px solid var(--line);
  }

  .point-title {
    font-weight: 600;
  }

  @media (max-width: 1023px) {
    .privacy {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
  }

  @media (max-width: 767px) {
    .point {
      padding: 20px;
    }
  }

  /* Get the app */
  .cta-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 var(--gutter) var(--section-y);
  }

  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding: 72px 64px;
    border-radius: 32px;
    background: var(--primary);
    color: var(--on-primary);
    text-align: center;
  }

  .cta .lead {
    color: rgb(255 255 255 / 0.8);
  }

  .cta :global(.cta-logo) {
    width: 72px;
    height: 72px;
    border-radius: 22.5%;
  }

  @media (max-width: 767px) {
    .cta {
      padding: 48px 24px;
      border-radius: 28px;
    }
  }
</style>
