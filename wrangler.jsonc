{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serves Astro's static build from Cloudflare Workers static assets.
  "name": "flashkards-marketing-site",
  "compatibility_date": "2026-10-15",
  // Cloudflare creates the DNS records and certificates for these on deploy.
  "routes": [
    { "pattern": "flashkards.app", "custom_domain": true },
    { "pattern": "www.flashkards.app", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
